{
  "name": "try-ottoman",
  "version": "1.0.0",
  "description": "The travel-sample API using the Ottoman Js v2",
  "main": "server.js",
  "scripts": {
    "start": "ts-node-dev --respawn src/index.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "typecheck": "tsc --noEmit -p test",
    "couchbase:start": "bash scripts/start-couchbase.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/couchbase-examples/try-ottoman-ts.git"
  },
  "keywords": [
    "OttomanJS",
    "Couchbase"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/couchbase-examples/try-ottoman-ts/issues"
  },
  "homepage": "https://github.com/couchbase-examples/try-ottoman-ts#readme",
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "ottoman": "2.5.8",
    "swagger-ui-express": "5.0.1",
    "yamljs": "0.3.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/express": "4.17.25",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@types/express-serve-static-core": "4.19.9"
  },
  "jest": {
    "testTimeout": 30000,
    "projects": [
      {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/test/unit/**/*.spec.ts"
        ]
      },
      {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/test/integration/**/*.spec.ts"
        ]
      }
    ]
  }
}
